<Window
    x:Class="BotBridge.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BotBridge"
    Width="1200"
    Height="700"
    WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->

        <Border Background="#1F2937">

            <StackPanel Margin="20">

                <TextBlock
                    Text="BotBridge"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0,0,0,30"/>

                <Button
                    Content="Dashboard"
                    Margin="0,0,0,10"
                    Height="40"
                    Command="{Binding ShowDashboardCommand}" />

                <Button
                    Content="Processes"
                    Margin="0,0,0,10"
                    Height="40"
                    Command="{Binding ShowProcessesCommand}" />

                <Button
                    Content="Schedules"
                    Margin="0,0,0,10"
                    Height="40"
                    Command="{Binding ShowSchedulesCommand}" />

                <Button
                    Content="Logs"
                    Margin="0,0,0,10"
                    Height="40"
                    Command="{Binding ShowLogsCommand}" />

                <Button
                    Content="Settings"
                    Margin="0,0,0,10"
                    Height="40"
                    Command="{Binding ShowSettingsCommand}" />
                            </StackPanel>

        </Border>

        <!-- Content -->

        <Grid Grid.Column="1"
            Background="#F5F7FA">

            <ContentControl
                Content="{Binding CurrentView}" />

        </Grid>

    </Grid>

</Window>