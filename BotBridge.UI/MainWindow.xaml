<Window
    x:Class="BotBridge.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BotBridge"
    Icon="pack://siteoforigin:,,,/Assets/BotBridge.ico"
    Width="1280"
    Height="760"
    MinWidth="960"
    MinHeight="600"
    WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             Sidebar
             ============================================================ -->

        <Border Background="{StaticResource BrushSidebarBackground}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->

                <StackPanel
                    Margin="24,28,24,20"
                    Orientation="Horizontal">

                    <Border
                        Width="34"
                        Height="34"
                        CornerRadius="9"
                        Background="{StaticResource BrushBrandGradient}">

                        <TextBlock
                            Text="B"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="BotBridge"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                        <TextBlock
                            Text="Automation Hub"
                            FontSize="11"
                            Foreground="{StaticResource BrushSidebarTextMuted}"/>

                    </StackPanel>

                </StackPanel>

                <!-- Navigation -->

                <StackPanel
                    Grid.Row="1"
                    Margin="14,10,14,0">

                    <TextBlock
                        Text="MENU"
                        Style="{StaticResource TextLabel}"
                        Foreground="{StaticResource BrushSidebarTextMuted}"
                        Margin="10,0,0,10"/>

                    <Button
                        Style="{StaticResource SidebarNavButtonStyle}"
                        Command="{Binding ShowDashboardCommand}"
                        Tag="{Binding IsDashboardActive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Text="&#xE80F;"
                                FontFamily="{StaticResource FontIcon}"
                                FontSize="16"
                                Width="22"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock
                                Text="Dashboard"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

