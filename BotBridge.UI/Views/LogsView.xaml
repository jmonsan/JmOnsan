<UserControl
    x:Class="BotBridge.UI.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <DockPanel>

            <TextBlock
                Text="Logs"
                FontSize="30"
                FontWeight="SemiBold"
                DockPanel.Dock="Left"/>

            <Button
                Content="Refresh"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                Command="{Binding RefreshCommand}"/>

        </DockPanel>

        <!-- Log files -->

        <Border
            Grid.Row="2"
            Background="White"
            CornerRadius="8"
            Padding="15">

            <DataGrid
                ItemsSource="{Binding LogFiles}"
                SelectedItem="{Binding SelectedLogFile}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                MouseDoubleClick="LogFiles_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Log File"
                        Binding="{Binding FileName}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Last Modified"
                        Binding="{Binding LastModified}"
                        Width="220"/>

                    <DataGridTextColumn
                        Header="Size (bytes)"
                        Binding="{Binding SizeInBytes}"
                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>
