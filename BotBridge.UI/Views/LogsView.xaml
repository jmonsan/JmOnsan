                <TextBlock
                    Text="Browse log files and open one to view its full contents."
                    Style="{StaticResource TextSecondary}"
                    Margin="0,6,0,0"/>

            </StackPanel>

            <Button
                Grid.Column="1"
                Style="{StaticResource SecondaryButtonStyle}"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="&#xE72C;"
                        FontFamily="{StaticResource FontIcon}"
                        FontSize="13"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Text="Refresh"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- Log files -->

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">

            <Grid>

                <DataGrid
                    Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding LogFiles}"
                    SelectedItem="{Binding SelectedLogFile}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    MouseDoubleClick="LogFiles_MouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="LOG FILE"
                            Binding="{Binding FileName}"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="LAST MODIFIED"
                            Binding="{Binding LastModified}"
                            Width="220"/>

                        <DataGridTextColumn
                            Header="SIZE (BYTES)"
                            Binding="{Binding SizeInBytes}"
                            Width="150"/>

                    </DataGrid.Columns>

                </DataGrid>

                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding LogFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">

                    <TextBlock
                        Text="&#xE81C;"
                        FontFamily="{StaticResource FontIcon}"
                        FontSize="26"
                        Foreground="{StaticResource BrushTextMuted}"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="No log files yet"
                        Style="{StaticResource TextSecondary}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Logs will appear here once the worker runs"
                        Style="{StaticResource TextSecondary}"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontSize="11.5"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
