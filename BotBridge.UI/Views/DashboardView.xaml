<UserControl
    x:Class="BotBridge.UI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="36,32,36,32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <StackPanel>

                <TextBlock
                    Text="Dashboard"
                    Style="{StaticResource TextDisplay}"/>

                <TextBlock
                    Text="Live view of the automation worker — refreshes automatically every 30 seconds."
                    Style="{StaticResource TextSecondary}"
                    Margin="0,6,0,0"/>

            </StackPanel>

            <!-- Tiles -->

            <WrapPanel Grid.Row="2" Orientation="Horizontal">

                <!-- Status -->

                <Border Style="{StaticResource CardStyle}" Width="272" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="STATUS" Style="{StaticResource TextLabel}"/>

                        <Border
                            Style="{StaticResource StatusPillStyle}"
                            Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0">

                            <StackPanel Orientation="Horizontal">

                                <Border
                                    Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}"/>

                                <TextBlock
                                    Text="{Binding Status}"
                                    Margin="7,0,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- Date & Time -->

                <Border Style="{StaticResource CardStyle}" Width="272" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="DATE &amp; TIME" Style="{StaticResource TextLabel}"/>

                        <TextBlock
                            Text="{Binding CurrentDateTime}"
                            Style="{StaticResource TextMetric}"
                            FontSize="19"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Running Processes -->

                <Border Style="{StaticResource CardStyle}" Width="272" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource TextLabel}"/>

                        <TextBlock
                            Text="{Binding RunningCount}"
                            Style="{StaticResource TextMetric}"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Current Task -->

                <Border Style="{StaticResource CardStyle}" Width="272" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="CURRENT TASK" Style="{StaticResource TextLabel}"/>

                        <TextBlock
                            Text="{Binding CurrentTask}"
                            Style="{StaticResource TextMetric}"
                            FontSize="18"
                            Margin="0,12,0,0"
                            TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                </Border>

                <!-- Next Schedule -->

                <Border Style="{StaticResource CardStyle}" Width="272" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="NEXT SCHEDULE" Style="{StaticResource TextLabel}"/>

                        <TextBlock
                            Text="{Binding NextSchedule}"
                            Style="{StaticResource TextMetric}"
                            FontSize="18"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Last Execution -->

                <Border Style="{StaticResource CardStyle}" Width="272" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="LAST EXECUTION" Style="{StaticResource TextLabel}"/>

                        <TextBlock
                            Text="{Binding LastExecution}"
                            Style="{StaticResource TextMetric}"
                            FontSize="18"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Last Result -->

                <Border Style="{StaticResource CardStyle}" Width="568" Margin="0,0,16,16">

                    <StackPanel>

                        <TextBlock Text="LAST RESULT" Style="{StaticResource TextLabel}"/>

                        <TextBlock
                            Text="{Binding LastResult}"
                            Style="{StaticResource TextBody}"
                            Margin="0,12,0,0"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </WrapPanel>

        </Grid>

    </ScrollViewer>

</UserControl>
