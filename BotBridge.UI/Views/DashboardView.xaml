<UserControl
    x:Class="BotBridge.UI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <TextBlock
                Text="Dashboard"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="#1F2937"/>

            <!-- Content -->

            <UniformGrid
                Grid.Row="2"
                Columns="2"
                Rows="3"
                Margin="0,10,0,0">

                <!-- Status -->

                <Border
                    Margin="10"
                    Padding="20"
                    Background="White"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Status"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding Status}"
                            Margin="0,10,0,0"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#16A34A"/>

                    </StackPanel>

                </Border>

                <!-- Current Task -->

                <Border
                    Margin="10"
                    Padding="20"
                    Background="White"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Current Task"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding CurrentTask}"
                            Margin="0,10,0,0"
                            FontSize="20"/>

                    </StackPanel>

                </Border>

                <!-- Next Schedule -->

                <Border
                    Margin="10"
                    Padding="20"
                    Background="White"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Next Schedule"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding NextSchedule}"
                            Margin="0,10,0,0"
                            FontSize="20"/>

                    </StackPanel>

                </Border>

                <!-- Last Execution -->

                <Border
                    Margin="10"
                    Padding="20"
                    Background="White"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Last Execution"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding LastExecution}"
                            Margin="0,10,0,0"
                            FontSize="20"/>

                    </StackPanel>

                </Border>

                <!-- Last Result -->

                <Border
                    Margin="10"
                    Padding="20"
                    Background="White"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Last Result"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding LastResult}"
                            Margin="0,10,0,0"
                            FontSize="20"/>

                    </StackPanel>

                </Border>

                <!-- Controls -->

                <Border
                    Margin="10"
                    Padding="20"
                    Background="White"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Controls"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,15"/>

                        <StackPanel
                            Orientation="Horizontal">

                            <Button
                                Content="Start"
                                Width="120"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding StartCommand}"/>

                            <Button
                                Content="Stop"
                                Width="120"
                                Height="40"
                                Command="{Binding StopCommand}"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </UniformGrid>

        </Grid>

    </ScrollViewer>

</UserControl>