<Window
    x:Class="BotBridge.UI.Views.LogDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="pack://siteoforigin:,,,/Assets/BotBridge.ico"
    Width="860"
    Height="620"
    ResizeMode="NoResize"
    Background="{StaticResource BrushPageBackground}"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Orientation="Horizontal">

            <Border
                Width="34"
                Height="34"
                CornerRadius="9"
                Background="{StaticResource BrushBrandSubtle}">

                <TextBlock
                    Text="&#xE81C;"
                    FontFamily="{StaticResource FontIcon}"
                    FontSize="15"
                    Foreground="{StaticResource BrushBrand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource TextTitle}"
                    FontSize="15"/>

                <TextBlock
                    Text="Log file contents"
                    Style="{StaticResource TextSecondary}"
                    FontSize="11.5"/>

            </StackPanel>

        </StackPanel>

        <!-- Content -->

        <Border
            Grid.Row="2"
            CornerRadius="12"
            Background="{StaticResource BrushSlate900}"
            Padding="4">

            <TextBox
                x:Name="ContentTextBox"
                Style="{StaticResource CodeEditorTextBoxStyle}"
                BorderThickness="0"
                Background="Transparent"
                IsReadOnly="True"/>

        </Border>

    </Grid>

</Window>
