<UserControl
    x:Class="BotBridge.UI.Views.SchedulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="36,32,36,32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel>

            <TextBlock Text="Schedules" Style="{StaticResource TextDisplay}"/>

            <TextBlock
                Text="Create and manage when each process runs."
                Style="{StaticResource TextSecondary}"
                Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Schedule Grid -->

            <Border Style="{StaticResource CardStyle}" Padding="16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="All Schedules"
                            Style="{StaticResource TextTitle}"
                            FontSize="14"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32"
                            Padding="12,0"
                            Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="&#xE72C;"
                                    FontFamily="{StaticResource FontIcon}"
                                    FontSize="12"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    Text="Refresh"
                                    Margin="6,0,0,0"
                                    FontSize="12.5"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                    <Grid Grid.Row="2">

                        <DataGrid
                            Style="{StaticResource DataGridStyle}"
                            ItemsSource="{Binding Schedules}"
                            SelectedItem="{Binding SelectedSchedule}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="PROCESS"
                                    Binding="{Binding ProcessName}"
                                    Width="*"/>

                                <DataGridTextColumn
                                    Header="TYPE"
                                    Binding="{Binding ScheduleType}"
                                    Width="110"/>

                                <DataGridTextColumn
                                    Header="NEXT RUN"
                                    Binding="{Binding StartDateTime}"
                                    Width="200"/>

                                <DataGridCheckBoxColumn
                                    Header="ENABLED"
                                    Binding="{Binding Enabled}"
                                    Width="90"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding Schedules.Count, Converter={StaticResource CountToVisibilityConverter}}">

                            <TextBlock
                                Text="&#xE787;"
                                FontFamily="{StaticResource FontIcon}"
                                FontSize="26"
                                Foreground="{StaticResource BrushTextMuted}"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="No schedules yet"
                                Style="{StaticResource TextSecondary}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="Create one using the panel on the right"
                                Style="{StaticResource TextSecondary}"
                                Foreground="{StaticResource BrushTextMuted}"
                                FontSize="11.5"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

            <!-- Create / Update Schedule -->

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="Create / Update Schedule"
                        Style="{StaticResource TextTitle}"
                        FontSize="15"
                        Margin="0,0,0,20"/>

                    <TextBlock Text="PROCESS" Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox
                        Style="{StaticResource ComboBoxStyle}"
                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                        ItemsSource="{Binding AvailableProcesses}"
                        SelectedItem="{Binding SelectedProcessName}"
                        Margin="0,0,0,16"/>

                    <TextBlock Text="SCHEDULE TYPE" Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox
                        Style="{StaticResource ComboBoxStyle}"
                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                        ItemsSource="{Binding ScheduleTypes}"
                        SelectedItem="{Binding SelectedScheduleType}"
                        Margin="0,0,0,16"/>

                    <TextBlock Text="START DATE / TIME" Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding StartDateTimeText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,4"/>

                    <TextBlock
                        Text="Format: yyyy-MM-dd HH:mm:ss"
                        FontSize="11"
                        Foreground="{StaticResource BrushTextMuted}"
                        Margin="1,0,0,16"/>

                    <TextBlock Text="DAY OF WEEK (WEEKLY ONLY)" Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox
                        Style="{StaticResource ComboBoxStyle}"
                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                        ItemsSource="{Binding DaysOfWeek}"
                        SelectedItem="{Binding SelectedDayOfWeek}"
