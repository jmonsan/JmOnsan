<UserControl
    x:Class="BotBridge.UI.Views.SchedulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <TextBlock
            Text="Schedules"
            FontSize="30"
            FontWeight="SemiBold"/>

        <!-- Content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Schedule Grid -->

            <Border
                Background="White"
                CornerRadius="8"
                Padding="15">

                <DockPanel>

                    <Button
                        Content="Refresh"
                        Height="35"
                        Width="120"
                        DockPanel.Dock="Top"
                        Margin="0,0,0,10"
                        Command="{Binding RefreshCommand}" />

                    <DataGrid
                        ItemsSource="{Binding Schedules}"
                        SelectedItem="{Binding SelectedSchedule}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Process"
                                Binding="{Binding ProcessName}"
                                Width="*" />

                            <DataGridTextColumn
                                Header="Type"
                                Binding="{Binding ScheduleType}"
                                Width="120" />

                            <DataGridTextColumn
                                Header="Next Run"
                                Binding="{Binding StartDateTime}"
                                Width="220" />

                            <DataGridCheckBoxColumn
                                Header="Enabled"
                                Binding="{Binding Enabled}"
                                Width="100" />

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>

            <!-- Create / Update Schedule -->

            <Border
                Grid.Column="2"
                Background="White"
                CornerRadius="8"
                Padding="15">

                <StackPanel>

                    <TextBlock
                        Text="Create / Update Schedule"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,0,0,15"/>

                    <TextBlock Text="Process"/>

                    <ComboBox
                        ItemsSource="{Binding AvailableProcesses}"
                        SelectedItem="{Binding SelectedProcessName}"
                        Margin="0,5,0,15"/>

                    <TextBlock Text="Schedule Type"/>

                    <ComboBox
                        ItemsSource="{Binding ScheduleTypes}"
                        SelectedItem="{Binding SelectedScheduleType}"
                        Margin="0,5,0,15"/>

                    <TextBlock Text="Start Date/Time (yyyy-MM-dd HH:mm:ss)"/>

                    <TextBox
                        Text="{Binding StartDateTimeText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,5,0,15"/>

                    <TextBlock Text="Day of Week (Weekly only)"/>

                    <ComboBox
                        ItemsSource="{Binding DaysOfWeek}"
                        SelectedItem="{Binding SelectedDayOfWeek}"
                        Margin="0,5,0,15"/>

                    <CheckBox
                        Content="Enabled"
                        IsChecked="{Binding ScheduleEnabled}"
                        Margin="0,0,0,10"/>

                    <CheckBox
                        Content="Run Missed Execution"
                        IsChecked="{Binding RunMissedExecution}"
                        Margin="0,0,0,10"/>

                    <CheckBox
                        Content="Prevent Duplicate Execution"
                        IsChecked="{Binding PreventDuplicateExecution}"
                        Margin="0,0,0,15"/>

                    <Button
                        Content="Save Schedule"
                        Height="35"
                        Command="{Binding SaveCommand}"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
