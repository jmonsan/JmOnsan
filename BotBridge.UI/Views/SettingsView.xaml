<UserControl
    x:Class="BotBridge.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Settings"
                FontSize="30"
                FontWeight="SemiBold"/>

            <Border
                Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox
                        Content="Enable Automation"
                        IsChecked="{Binding Enabled}" />

                    <StackPanel Grid.Row="2">

                        <TextBlock Text="Packages Folder"/>

                        <TextBox
                            Text="{Binding PackagesFolder}" />

                    </StackPanel>

                    <StackPanel Grid.Row="4">

                        <TextBlock Text="Config Folder"/>

                        <TextBox
                            Text="{Binding ConfigFolder}" />

                    </StackPanel>

                    <StackPanel Grid.Row="6">

                        <TextBlock Text="Logs Folder"/>

                        <TextBox
                            Text="{Binding LogsFolder}" />

                    </StackPanel>

                    <StackPanel Grid.Row="8">

                        <TextBlock
                            Text="Process Timeout (Minutes)"/>

                        <TextBox
                            Text="{Binding ProcessTimeoutMinutes}" />

                    </StackPanel>

                    <CheckBox
                        Grid.Row="10"
                        Content="Run Missed Schedules"
                        IsChecked="{Binding RunMissedSchedules}" />

                </Grid>

            </Border>

            <StackPanel
                Grid.Row="4"
                Orientation="Horizontal">

                <Button
                    Content="Save"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}" />

                <Button
                    Content="Reload"
                    Width="120"
                    Height="40"
                    Command="{Binding ReloadCommand}" />

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>