<UserControl
    x:Class="BotBridge.UI.Views.ProcessesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <TextBlock
            Text="Processes"
            FontSize="30"
            FontWeight="SemiBold"/>

        <!-- Content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Process List -->

            <Border
                Background="White"
                CornerRadius="8"
                Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button
                        Content="Refresh"
                        Height="35"
                        Command="{Binding RefreshCommand}"/>

                    <ListBox
                        Grid.Row="2"
                        ItemsSource="{Binding Processes}"
                        SelectedItem="{Binding SelectedProcess}"
                        DisplayMemberPath="Name"/>

                </Grid>

            </Border>

            <!-- Editor -->

            <Border
                Grid.Column="2"
                Background="White"
                CornerRadius="8"
                Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Process -->

                    <TextBlock
                        Text="{Binding SelectedProcess.Name}"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <!-- BAT File Content -->

                    <TextBox
                        Grid.Row="2"
                        Text="{Binding ProcessContent, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        FontFamily="Consolas"
                        FontSize="13"
                        TextWrapping="NoWrap"/>

                    <!-- Actions -->

                    <StackPanel
                        Grid.Row="4"
                        Orientation="Horizontal">

                        <Button
                            Content="Save"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Command="{Binding SaveCommand}"/>

                        <Button
                            Content="Run Now"
                            Width="120"
                            Height="40"
                            Command="{Binding RunCommand}"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>